  "tab.border": "#07070B",
  "tab.hoverBackground": "#14141F",
  "tab.unfocusedActiveBorderTop": "#2C2C40",
  "editor.background": "#0E0E16",
  "editor.foreground": "#ECEBFA",
  "editorLineNumber.foreground": "#3A3A52",
