  "list.hoverBackground": "#14141F",
  "list.focusOutline": "#7C6CFF99",
  "list.highlightForeground": "#B7A9FF",
  "list.errorForeground": "#FF4D8D",
  "list.warningForeground": "#FFB454",
  "tree.indentGuidesStroke": "#2C2C40",
  "editorGroupHeader.tabsBackground": "#0B0B12",
