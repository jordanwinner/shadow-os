<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
  "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Shadow OS</vendor>
  <action id="os.shadow.ecran-tactile">
    <description>Activer ou désactiver l'écran tactile</description>
    <message>L'activation de l'écran tactile nécessite une autorisation</message>
    <icon_name>os.shadow.EcranTactile</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/shadow-ecran-tactile</annotate>
  </action>
</policyconfig>
