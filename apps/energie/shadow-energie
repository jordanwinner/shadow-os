#!/bin/sh
# shadow-energie — choisit le mode d'énergie du portable (Shadow OS).
# Usage : shadow-energie frais | equilibre | performance | etat
#
# Le mode est écrit dans un fichier TLP (lu après les autres fichiers de
# /etc/tlp.d, donc prioritaire) puis appliqué tout de suite avec « tlp start ».
# Il est conservé au redémarrage.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 022
CONF=/etc/tlp.d/95-shadow-energie.conf
ETAT=/etc/shadow-os/energie-profil

etat() {
    if [ -r "$ETAT" ]; then cat "$ETAT"; else echo inconnu; fi
}

# ecrire NOM EPP_SECTEUR EPP_BATTERIE TURBO_SECTEUR TURBO_BATTERIE PLATEFORME_SECTEUR PLATEFORME_BATTERIE ELAN_SECTEUR
ecrire() {
    tmp=$(mktemp "$CONF.XXXXXX")
    cat > "$tmp" <<FIN
# Shadow OS — mode d'énergie « $1 » (géré par shadow-energie, ne pas modifier à la main)
CPU_SCALING_GOVERNOR_ON_AC=powersave
CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_AC=$2
CPU_ENERGY_PERF_POLICY_ON_BAT=$3
CPU_BOOST_ON_AC=$4
CPU_BOOST_ON_BAT=$5
PLATFORM_PROFILE_ON_AC=$6
PLATFORM_PROFILE_ON_BAT=$7
CPU_HWP_DYN_BOOST_ON_AC=$8
CPU_HWP_DYN_BOOST_ON_BAT=0
FIN
    chmod 644 "$tmp"
    mv -f "$tmp" "$CONF"
    tlp start >/dev/null
    mkdir -p "$(dirname "$ETAT")"
    printf '%s\n' "$1" > "$ETAT"
}

case "${1:-etat}" in
    frais)       ecrire frais       balance_power       power               1 0 quiet       quiet    0; etat ;;
    equilibre)   ecrire equilibre   balance_performance balance_power       1 1 balanced    balanced 1; etat ;;
    performance) ecrire performance performance         balance_performance 1 1 performance balanced 1; etat ;;
    etat|status) etat ;;
    *) echo "usage : $0 frais | equilibre | performance | etat" >&2; exit 2 ;;
esac
