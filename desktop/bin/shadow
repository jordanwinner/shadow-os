#!/usr/bin/env bash
# shadow — pilote shadow-desktop (thème, fonds d'écran, touches, raccourcis) sans sudo.
set -euo pipefail

DATA="$HOME/.local/share/shadow-desktop"
WALL="$DATA/wallpapers"
THEME_SH="$DATA/theme/shadow-theme.sh"
FETCH_CFG="$DATA/fastfetch/shadow.jsonc"
SELF="$HOME/.local/bin/shadow"
DI_PATH="/org/gnome/shell/extensions/dynamic-island-v2"
KB_SCHEMA="org.gnome.settings-daemon.plugins.media-keys.custom-keybinding"
KB_LIST="org.gnome.settings-daemon.plugins.media-keys custom-keybindings"
KB_ROOT="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings"
KB_NAMES=(shadow-wall shadow-slideshow shadow-keycast)

head(){ printf '\033[1;35m▸ %s\033[0m\n' "$*"; }
ok(){ printf '  \033[32m✓\033[0m %s\n' "$*"; }
die(){ printf '\033[31m✗ %s\033[0m\n' "$*" >&2; exit 1; }

usage(){ cat <<EOF
shadow — customisation du bureau (sans sudo)

  shadow theme [apply|revert|status]      thème Shadow (réversible)
  shadow wall next [anime|hacker|all|auto]  fond aléatoire (auto = jour/nuit)
  shadow wall dl [anime|hacker|both] [n]  télécharge des fonds (défaut both 15)
  shadow wall slideshow [on|off|toggle|status|interval MIN]
  shadow keycast [on|off|toggle]          touches à l'écran dans l'îlot
  shadow todo [list|add TXT|done N|rm N|clear]   to-do de l'îlot
  shadow keys [install|remove]            raccourcis clavier Super+Shift+W/S/K
  shadow fetch                            infos système façon Shadow (fastfetch)
  shadow dub FROM TO [sub|dub|both]       traduit le son d'un film en direct
                                          FROM = auto ou en/fr/es/de/it/pt/ru/zh…
                                          (ex: shadow dub en fr · shadow dub auto fr)
                                          Ctrl+C arrête
  shadow dub off                          arrête le traducteur
  shadow status                           état de tout
EOF
}

# --- fusionne/retire des chemins dans la liste des raccourcis personnalisés ---
_kb_list(){
  python3 - "$1" "${@:2}" <<'PY'
import ast, subprocess, sys
action, items = sys.argv[1], sys.argv[2:]
raw = subprocess.check_output(['gsettings','get','org.gnome.settings-daemon.plugins.media-keys','custom-keybindings']).decode()
cur = ast.literal_eval(raw.replace('@as ',''))
if action == 'add':
    for p in items:
        if p not in cur: cur.append(p)
else:
    cur = [p for p in cur if p not in items]
subprocess.check_call(['gsettings','set','org.gnome.settings-daemon.plugins.media-keys','custom-keybindings',str(cur)])
PY
}

keys_install(){
  need_scripts
  local specs=(
    "shadow-wall|Shadow: fond suivant|$WALL/wallpaper-next.sh all|<Super><Shift>w"
    "shadow-slideshow|Shadow: diaporama|$SELF wall slideshow toggle|<Super><Shift>s"
    "shadow-keycast|Shadow: touches à l'écran|$SELF keycast toggle|<Super><Shift>k"
  )
  local paths=()
  for s in "${specs[@]}"; do
    IFS='|' read -r name n cmd bind <<< "$s"
    local p="$KB_ROOT/$name/"
    gsettings set "$KB_SCHEMA:$p" name "$n"
    gsettings set "$KB_SCHEMA:$p" command "$cmd"
    gsettings set "$KB_SCHEMA:$p" binding "$bind"
    paths+=("$p")
  done
  _kb_list add "${paths[@]}"
  ok "Super+Shift+W → fond suivant"
  ok "Super+Shift+S → diaporama on/off"
  ok "Super+Shift+K → touches à l'écran"
}

keys_remove(){
  local paths=()
  for name in "${KB_NAMES[@]}"; do paths+=("$KB_ROOT/$name/"); done
  _kb_list remove "${paths[@]}"
  for p in "${paths[@]}"; do dconf reset -f "$p" 2>/dev/null || true; done
  ok "raccourcis Shadow retirés"
}

need_scripts(){ [ -d "$WALL" ] || die "scripts non installés ($WALL). Lance ./install.sh"; }

# gère la liste de tâches (clé dconf 'todos', GVariant 'as')
todo_py(){
  python3 - "$DI_PATH/todos" "$@" <<'PY'
import subprocess, sys, ast
key, action, rest = sys.argv[1], sys.argv[2], sys.argv[3:]
raw = subprocess.run(['dconf','read',key], capture_output=True, text=True).stdout.strip()
if raw.startswith('@'):            # annotation de type GVariant (ex. « @as [] »)
    raw = raw.split(' ', 1)[1] if ' ' in raw else ''
cur = ast.literal_eval(raw) if raw else []
def gv(lst):
    return '[' + ', '.join('"' + s.replace('\\','\\\\').replace('"','\\"') + '"' for s in lst) + ']'
def save(): subprocess.run(['dconf','write',key, gv(cur)])
if action == 'add':
    cur.append('0|' + ' '.join(rest)); save(); print('ajoute :', ' '.join(rest))
elif action in ('done','rm'):
    i = int(rest[0])
    if 0 <= i < len(cur):
        if action == 'done':
            d = cur[i].startswith('1|'); cur[i] = ('0|' if d else '1|') + cur[i][2:]
        else:
            cur.pop(i)
        save()
    else:
        print('index hors limites'); sys.exit(1)
else:
    for i, t in enumerate(cur):
        print(f"  {i}  [{'x' if t.startswith('1|') else ' '}] {t[2:]}")
    if not cur: print('  (vide)  —  shadow todo add "ma tache"')
PY
}

case "${1:-status}" in
  theme)
    [ -x "$THEME_SH" ] || die "thème non installé ($THEME_SH)"
    exec "$THEME_SH" "${2:-apply}" ;;

  wall|wallpaper)
    need_scripts
    case "${2:-next}" in
      next)      exec "$WALL/wallpaper-next.sh" "${3:-all}" ;;
      dl)        exec "$WALL/wallpaper-dl.sh" "${3:-both}" "${4:-15}" ;;
      slideshow) exec "$WALL/slideshow-ctl.sh" "${3:-status}" ;;
      *) die "wall: next | dl | slideshow" ;;
    esac ;;

  keycast)
    case "${2:-toggle}" in
      on)     dconf write "$DI_PATH/keycast" true;  ok "touches à l'écran : ON" ;;
      off)    dconf write "$DI_PATH/keycast" false; ok "touches à l'écran : OFF" ;;
      toggle)
        cur="$(dconf read "$DI_PATH/keycast" 2>/dev/null || echo false)"
        if [ "$cur" = "true" ]; then dconf write "$DI_PATH/keycast" false; ok "touches : OFF";
        else dconf write "$DI_PATH/keycast" true; ok "touches : ON"; fi ;;
      *) die "keycast: on | off | toggle" ;;
    esac ;;

  todo)
    case "${2:-list}" in
      add)   shift 2 2>/dev/null || true; [ "$#" -ge 1 ] && todo_py add "$@" || die "shadow todo add \"ma tâche\"" ;;
      done)  todo_py done "${3:?index ?}" ;;
      rm)    todo_py rm "${3:?index ?}" ;;
      clear) dconf write "$DI_PATH/todos" "@as []"; ok "liste vidée" ;;
      list|*) todo_py list ;;
    esac ;;

  keys)
    case "${2:-install}" in
      install) head "Raccourcis clavier"; keys_install ;;
      remove)  keys_remove ;;
      *) die "keys: install | remove" ;;
    esac ;;

  dub)
    DUB="$DATA/dub/shadow-dub.py"
    case "${2:-}" in
      off|stop)
        pid_f="$DATA/dub.pid"
        [ -f "$pid_f" ] && kill "$(cat "$pid_f")" 2>/dev/null || true
        pkill -f shadow-dub.py 2>/dev/null || true
        ok "traducteur arrêté" ;;
      status)
        pgrep -f shadow-dub.py >/dev/null && echo "en cours" || echo "arrêté" ;;
      "")
        die "usage: shadow dub <source> <cible> [sub|dub|both]   (ex: shadow dub en fr)" ;;
      *)
        [ -f "$DUB" ] || die "traducteur non installé ($DUB) — relance ./install.sh"
        exec python3 "$DUB" --from "$2" --to "${3:-fr}" --mode "${4:-sub}" --model "${SHADOW_DUB_MODEL:-base}" ;;
    esac ;;

  fetch)
    if command -v fastfetch >/dev/null 2>&1 && [ -f "$FETCH_CFG" ]; then exec fastfetch --config "$FETCH_CFG"
    elif command -v fastfetch >/dev/null 2>&1; then exec fastfetch
    elif command -v neofetch >/dev/null 2>&1; then exec neofetch
    else die "ni fastfetch ni neofetch installé"; fi ;;

  status)
    head "shadow-desktop"
    if [ -x "$THEME_SH" ]; then "$THEME_SH" status; fi
    kc="$(dconf read "$DI_PATH/keycast" 2>/dev/null || true)"
    printf "  Keycast   : %s\n" "${kc:-false (défaut)}"
    if [ -d "$WALL" ]; then
      printf "  Diaporama : %s\n" "$(systemctl --user is-active slideshow.timer 2>/dev/null || echo inactif)"
      printf "  Fonds     : %s image(s)\n" "$(find "$HOME/Images/Wallpapers" -type f 2>/dev/null | wc -l)"
    fi
    kb="$(gsettings get org.gnome.settings-daemon.plugins.media-keys custom-keybindings 2>/dev/null || echo '[]')"
    case "$kb" in *shadow-*) printf "  Raccourcis: installés\n";; *) printf "  Raccourcis: non installés (shadow keys install)\n";; esac ;;

  -h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac
